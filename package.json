{
  "name": "bookingkit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && pnpm build:worker",
    "build:worker": "tsup",
    "start": "node .next/standalone/server.js",
    "worker": "tsx worker/main.ts",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx db/seed/seed.ts",
    "brand": "tsx scripts/apply-client.ts",
    "lang:check": "tsx scripts/lang-check.ts",
    "import:dibs": "tsx extensions/dibs-import/script.ts",
    "staff:create": "tsx scripts/staff-create.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@aws-sdk/client-s3": "3.1156.0",
    "@date-fns/tz": "1.5.0",
    "@fontsource-variable/alexandria": "5.3.0",
    "@fontsource-variable/fredoka": "^5.3.0",
    "@fontsource-variable/heebo": "5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource-variable/rubik": "5.2.8",
    "@fullcalendar/react": "7.1.3",
    "argon2": "0.45.1",
    "date-fns": "4.4.0",
    "next": "16.4.3",
    "next-intl": "4.14.9",
    "otplib": "13.5.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "temporal-polyfill": "1.0.6",
    "use-intl": "4.14.9",
    "web-push": "3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "3.6.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "postcss": "8.5.31",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
