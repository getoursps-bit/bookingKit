# Environment variables
#
# Copy this file to the server's .env (~/Containers/<client>/.env) and fill
# in the values there. Never commit a filled-in copy.
# Locally, leave PROVIDERS=fake: no real keys are needed to develop or test.
# On the server use PROVIDERS=real. Each service below is all or nothing: fill
# in all its keys to turn it on, or leave them all empty to switch its
# features off (for example, no WhatsApp keys: online booking shows "call the
# salon" instead). A partly filled service stops the app from starting.

# --- App ---------------------------------------------------------------------

# Public address used in links and messages (showcase now, client domain later).
APP_BASE_URL=https://example.co.il
# Port the web server listens on.
PORT=3000
# Health check path; answers 200 when the app and database are up.
HEALTH_PATH=/healthz
# Log detail: debug, info, warn or error.
LOG_LEVEL=info
# Signs staff sessions, private links and trusted-device cookies. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=
# "fake" uses built-in test providers (local and CI); "real" uses the keys
# below and switches off any service whose keys are empty.
PROVIDERS=fake
# Keeps search engines out until go-live. Set to false only on launch day.
SITE_NOINDEX=true

# --- Database ----------------------------------------------------------------

# Postgres connection for the app's own restricted role, with rights on its
# own schema only. Example: postgres://app_user:PASSWORD@HOST:5432/postgres
DATABASE_URL=
# The schema that holds the app's tables. Leave empty for "app".
DB_SCHEMA=

# --- Image storage (Supabase Storage, S3-compatible) ------------------------

# S3 endpoint of Supabase Storage, e.g. https://<host>/storage/v1/s3
STORAGE_ENDPOINT=
# Bucket for gallery, product and pet photos.
STORAGE_BUCKET=
# S3 access keys created in Supabase Storage settings.
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# --- WhatsApp (Meta Cloud API) ----------------------------------------------

# Permanent access token from the Meta Business system user.
WHATSAPP_API_TOKEN=
# Phone number ID of the automated sender number (from WhatsApp Manager).
WHATSAPP_PHONE_NUMBER_ID=
# WhatsApp Business Account ID that holds the message templates.
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Meta app secret, used to check the signature of WhatsApp callbacks.
WEBHOOK_SECRET_MESSAGING=
# Token you choose; Meta sends it back once when the webhook is first verified.
WHATSAPP_VERIFY_TOKEN=

# --- Email fallback (HTTPS email service) -----------------------------------

# Send endpoint of the email service (e.g. Resend or Postmark).
EMAIL_API_URL=
# API key for that service.
EMAIL_API_KEY=
# Sender address on a domain with SPF and DKIM set up, e.g. "Example Salon <no-reply@example.co.il>".
EMAIL_FROM=

# --- Owner alerts (browser push) --------------------------------------------

# Generate once and never change (changing them stops every phone's alerts):
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services, as mailto: or https: URL.
VAPID_SUBJECT=mailto:

# --- AI (optional features) -------------------------------------------------

# Anthropic API key. Leave empty to keep the AI features unavailable.
AI_API_KEY=
# The model, confirmed with the owner before the first paid call. Required with the key.
AI_MODEL=
# Prices for AI_MODEL in agorot per million tokens (from the provider's price list),
# used to count spend against the monthly AI cap.
AI_PRICE_INPUT_AGOROT_PER_MTOK=
AI_PRICE_OUTPUT_AGOROT_PER_MTOK=
