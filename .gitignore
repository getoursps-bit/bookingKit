# Secrets: only env.example is committed
.env
.env.*
!env.example

# Dependencies and build output
node_modules/
.next/
dist/
coverage/
playwright-report/
test-results/

# OS
.DS_Store

# Generated by TypeScript and Next.js
tsconfig.tsbuildinfo
next-env.d.ts

# Local-only notes, never committed
local/

# Page pictures taken by tests/e2e/visual.spec.ts; they differ by machine
tests/e2e/*-snapshots/

# Clients' blueprints are kept beside the kit's code, not in its history: a
# client's project is a clone of the kit and must not carry the others'.
blueprints/*
!blueprints/example.yaml
